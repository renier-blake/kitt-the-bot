{
  "name": "kitt",
  "version": "0.1.0",
  "description": "Knowledge Interface for Transparent Tasks - Personal AI Assistant",
  "type": "module",
  "scripts": {
    "bridge": "tsx watch src/bridge/index.ts",
    "bridge:start": "tsx src/bridge/index.ts",
    "search": "tsx src/cli/kitt-search.ts",
    "mode": "tsx src/cli/kitt-mode.ts",
    "tts": "tsx src/cli/kitt-tts.ts",
    "tts:elevenlabs": "tsx src/cli/kitt-tts.ts",
    "tts:kokoro": "tsx src/cli/kitt-tts-kokoro.ts",
    "podcast": "tsx src/cli/kitt-podcast.ts",
    "migrate-credentials": "tsx src/cli/migrate-credentials.ts",
    "build": "tsc && npm run portal:build",
    "typecheck": "tsc --noEmit",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:stop": "pm2 stop kitt-bridge",
    "pm2:restart": "pm2 restart kitt-bridge",
    "pm2:logs": "pm2 logs kitt-bridge",
    "pm2:status": "pm2 status",
    "setup:permissions": "./scripts/setup-permissions.sh",
    "portal:dev": "cd frontends/portal && npm run dev",
    "portal:build": "cd frontends/portal && npm install && npm run build",
    "portal:install": "cd frontends/portal && npm install"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.34",
    "@anthropic-ai/sdk": "^0.74.0",
    "@libsql/client": "^0.17.0",
    "@nangohq/node": "^0.69.30",
    "@slack/bolt": "^4.6.0",
    "@slack/web-api": "^7.14.0",
    "@whiskeysockets/baileys": "^7.0.0-rc.9",
    "dotenv": "^16.4.0",
    "express": "^5.2.1",
    "grammy": "^1.21.0",
    "openai": "^6.21.0",
    "sqlite-vec": "^0.1.7-alpha.2",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
